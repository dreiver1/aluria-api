generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database.db"
}

model Turma {
  id                       String       @id @default(cuid())
  nome                     String
  alunos                   Aluno[]
  professores              professores? @relation(fields: [professoresIdprofessores], references: [idprofessores])
  professoresIdprofessores String?
}

model Aluno {
  idAluno                   String  @id @default(cuid())
  nome                      String
  dataNascimento            String
  celular                   String
  email                     String
  senha                     String
  cpf                       String?
  professores_idprofessores String?
  notas                     notas[]
  Turma                     Turma?  @relation(fields: [turmaId], references: [id])
  turmaId                   String?

  @@index([professores_idprofessores], map: "fk_alunos_professores_idx")
}

model administradores {
  idAdm          Int    @id @default(autoincrement())
  nome           String
  dataNascimento String
  cpf            String
  celular        String
  email          String
  senha          String

  @@unique(fields: [email], name: "usuario")
}

model InstallationState {
  id                     Int       @id @default(1)
  status                 String    @default("UNCONFIGURED")
  bootstrapCodeHash      String?
  bootstrapCodeExpiresAt DateTime?
  attemptCount           Int       @default(0)
  lockedUntil            DateTime?
  consumedAt             DateTime?
  configuredAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model notas {
  idnotas       Int     @id @default(autoincrement())
  nota01        Float?
  nota02        Float?
  nota03        Float?
  nota04        Float?
  alunos        Aluno?  @relation(fields: [alunosIdAluno], references: [idAluno])
  alunosIdAluno String?
}

model professores {
  idprofessores  String  @id @default(cuid())
  nome           String?
  dataNascimento String?
  celular        String?
  cpf            String?
  email          String?
  senha          String?
  turmas         Turma[]
}
